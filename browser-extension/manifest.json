{
  "manifest_version": 3,
  "name": "+downloads",
  "version": "4.4.0",
  "description": "Send the page you're on to the +downloads desktop app in one click.",
  "permissions": ["contextMenus", "storage", "notifications", "activeTab"],
  "host_permissions": [
    "http://127.0.0.1:5055/*",
    "http://localhost:5055/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Download with +downloads",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "downloads@digitaldownloads.space",
      "strict_min_version": "115.0"
    }
  }
}
